ENVIRONMENT=staging
SECRET_KEY=generate-a-new-high-entropy-value
JWT_SECRET_KEY=generate-a-new-value-of-at-least-32-random-bytes

# Keep browser access disabled until the identity bridge is implemented.
ALLOWED_ORIGINS=

# Medplum remains the clinical system of record.
FHIR_PROVIDER=medplum
MEDPLUM_PROFILE=patient
MEDPLUM_FHIR_BASE_URL=https://api.eai-medplum-staging.tech/fhir/R4
MEDPLUM_PATIENT_CLIENT_ID=
MEDPLUM_PATIENT_CLIENT_SECRET=

# Disable optional external services for the first synthetic-only deployment.
USE_EMAIL_MICROSERVICE=false
EMAIL_ENABLED=false
EMAIL_SERVICE_URL=http://email-service.invalid
EMAIL_SERVICE_API_KEY=disabled-staging-placeholder
PUBMED_SERVICE_ENABLED=false
USE_MIXEHR_SERVICE=false
USE_TRANSCRIPTION_MICROSERVICE=false

GCP_PROJECT=disabled-staging-placeholder
GCP_LOCATION=northamerica-northeast1
GEMINI_MODEL=disabled-staging-placeholder
